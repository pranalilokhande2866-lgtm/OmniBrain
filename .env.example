# Copy this file to .env and fill in your own values.
#   cp .env.example .env

# ============================================================
# REQUIRED (one of the two below) — the agentic reasoning
# (Supervisor, SQL generation, vision/chart analysis, Self-RAG
# grading, final synthesis) needs an LLM. Set ONE of these two:
# ============================================================

# --- Option A: Google Gemini (recommended - free, no billing needed) ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Option B: OpenAI GPT-4o (needs a paid account with credits) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# If both are set, Gemini is used (it's free - see agents/llm.py).
# Model used for text reasoning nodes (supervisor, sql, grading, synthesis)
OPENAI_CHAT_MODEL=gpt-4o
# Model used for the vision agent (must be vision-capable)
OPENAI_VISION_MODEL=gpt-4o

# ============================================================
# OPTIONAL — Qdrant. Leave QDRANT_URL empty to use local/embedded
# mode (data/qdrant_storage/ on disk, zero setup). Set QDRANT_URL
# to point at a real Qdrant server (e.g. via docker-compose.yml)
# once you want persistence across processes / production use.
# ============================================================
QDRANT_URL=
QDRANT_API_KEY=

# ============================================================
# OPTIONAL — Langfuse observability (Week 4). If left blank, the
# app runs fine and just skips tracing — nothing breaks.
# Get keys at https://cloud.langfuse.com (free tier available)
# ============================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================================
# App settings
# ============================================================
# Max Self-RAG rewrite loops before giving up and answering anyway
SELF_RAG_MAX_RETRIES=2
# Where uploaded PDFs and local Qdrant storage live. Leave this unset -
# config.py computes an absolute path anchored to the project root by
# default, which works correctly regardless of which directory you
# launch the backend/frontend from. Only set this if you specifically
# want data stored somewhere else, and use an ABSOLUTE path if so -
# a relative value here will override that safe default and can break
# in exactly the way it broke before this comment was added.
# DATA_DIR=/absolute/path/if/you/really/need/one
